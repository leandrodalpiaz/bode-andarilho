# =====================================================================
# BODE ANDARILHO - ARQUIVO DE CONFIGURAÇÃO DE EXEMPLO
# =====================================================================
# Instruções:
# 1. Copie este arquivo e renomeie para ".env" na raiz do projeto.
# 2. Preencha as credenciais reais abaixo.
# 3. O arquivo ".env" nunca deve ser enviado ao repositório Git.
# =====================================================================

# ---------------------------------------------------------------------
# ⚙️ CONFIGURAÇÕES DO SUPABASE (OBRIGATÓRIO)
# ---------------------------------------------------------------------
# URL do seu projeto Supabase (ex: https://xyzabc.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave histórica usada pelo bot; pode ser secreta e fica somente no backend.
# A PWA também a aceita como fallback para SUPABASE_SERVICE_ROLE_KEY, nunca no navegador.
SUPABASE_KEY=chave-legada-do-backend
# Chave publicável equivalente usada pelo frontend (nunca coloque service role aqui)
SUPABASE_ANON_KEY=sua-chave-publicavel-aqui
# Chave secreta somente no backend; se omitida, a PWA reutiliza SUPABASE_KEY
# para manter compatibilidade com o ambiente existente.
SUPABASE_SERVICE_ROLE_KEY=chave-secreta-apenas-no-servidor

# ---------------------------------------------------------------------
# 🤖 CONFIGURAÇÕES DO TELEGRAM (obrigatório enquanto o canal estiver ativo)
# ---------------------------------------------------------------------
# Token gerado pelo @BotFather para o seu bot
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# ID numérico do grupo principal do Telegram (com o sinal de menos se aplicável)
GRUPO_PRINCIPAL_ID=-1001234567890

# ---------------------------------------------------------------------
# 🌐 CONFIGURAÇÕES DO SERVIDOR E WEBHOOK
# ---------------------------------------------------------------------
# URL pública onde o servidor está acessível (ex: Render, Railway, Ngrok)
RENDER_EXTERNAL_URL=https://seu-app.onrender.com
# Porta local em que o servidor Starlette/Uvicorn irá escutar
PORT=10000
# Caminho relativo do endpoint do webhook
WEBHOOK_PATH=/telegram/webhook
# Segredo para validar requisições genuínas do Telegram (opcional mas recomendado)
TELEGRAM_WEBHOOK_SECRET=seu-segredo-anti-fraude-token
# Descartar atualizações pendentes na inicialização do bot (true/false)
DROP_PENDING_UPDATES_ON_BOOT=false

# ---------------------------------------------------------------------
# 👑 SEGURANÇA E PERMISSÕES
# ---------------------------------------------------------------------
# Seu ID do Telegram para bypass automático de permissões nível 3 (Admin Master)
ADMIN_TELEGRAM_ID=seu-telegram-id-numerico

# ---------------------------------------------------------------------
# 🧭 PWA / MIGRAÇÃO V2
# ---------------------------------------------------------------------
# Pepper usado para armazenar hashes de convite, recibo e idempotência
PWA_TOKEN_PEPPER=gere-um-segredo-longo-e-aleatorio
# Token temporário de uso único para POST /api/v1/bootstrap/admin
PWA_BOOTSTRAP_TOKEN=token-temporario-de-bootstrap
# URL pública usada nos links de convite e evento
PWA_PUBLIC_BASE_URL=https://seu-app.onrender.com
# Diretório do build frontend; no container fica em /app/web/dist
PWA_FRONTEND_DIST=web/dist
# Proteção conservadora do endpoint público de presença
PWA_PUBLIC_RATE_LIMIT=8
PWA_PUBLIC_RATE_WINDOW_SECONDS=300
# Ativar antes do piloto depois de configurar PWA_CAPTCHA_SECRET
PWA_PUBLIC_CAPTCHA_REQUIRED=false
PWA_CAPTCHA_SITE_KEY=chave-publica-do-provedor-captcha
PWA_CAPTCHA_SECRET=segredo-do-provedor-captcha
# Variáveis VITE_* são usadas somente no build do navegador e devem conter a chave publicável.
# VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel-aqui
# Flags de coexistência: manter assim até o piloto ser homologado.
PWA_ENABLED=true
TELEGRAM_ENABLED=true
TELEGRAM_MUTATIONS_TO_PWA=false
# Opcional no piloto: IDs de lojas separados por vírgula; a flag global acima
# continua desligada para preservar as demais lojas no fluxo legado.
TELEGRAM_MUTATIONS_TO_PWA_STORES=
TELEGRAM_NOTIFICATIONS_ENABLED=true

# ---------------------------------------------------------------------
# APOIO INSTITUCIONAL / DOACOES
# ---------------------------------------------------------------------
APOIO_PIX_CHAVE=sua-chave-pix
APOIO_PIX_TIPO=CPF
APOIO_PIX_BANCO=Banco do Brasil
APOIO_DOACOES_ATIVAS=false
